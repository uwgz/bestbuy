# Copy to .env for your computer; on Vercel set these in Settings → Environment Variables.
# Neon connection string (Neon → Connect → copy the pooled one, with -pooler in the host).
# Leave it out to use a local SQLite file instead (instance/bestbuy.db).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Vercel Blob: where uploaded photos go. Vercel adds this itself when the Blob store is connected to the project;
# copy it here (Vercel → Storage → your store → .env.local) only to upload photos from your computer.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Minutes without activity before the admin signs you out (default 15)
# ADMIN_IDLE_MINUTES=15
