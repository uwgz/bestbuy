# Copy to .env and fill in. Never share the real .env file.
# On Vercel, put the same names in Project → Settings → Environment Variables instead.

# A long random string — REQUIRED on Vercel:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development or production (Vercel uses production automatically)
FLASK_ENV_NAME=development
# 0.0.0.0 lets phones on your Wi-Fi open the site in development
HOST=127.0.0.1

# --- Database (optional locally, needed on Vercel) ---
# Turso = hosted SQLite. Leave empty to use the local file instance/vision.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Photos (optional locally, needed on Vercel) ---
# Added automatically when you connect a *public* Vercel Blob store to the project.
# Leave empty to keep photos in instance/uploads
BLOB_READ_WRITE_TOKEN=
