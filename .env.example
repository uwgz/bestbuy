# Copy this file to .env and fill it in. Never share or upload the real .env.
# On Vercel, put the same names in Project → Settings → Environment Variables instead.

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development on your computer (Vercel uses production automatically)
FLASK_ENV_NAME=development
# 0.0.0.0 lets phones on your Wi-Fi open the site while you test
HOST=127.0.0.1

# Database: your Neon connection string (Neon → Connect). Leave empty to use a local file instead.
DATABASE_URL=

# Photo storage on Vercel (added automatically when you connect a Public Blob store). Leave empty locally.
BLOB_READ_WRITE_TOKEN=
