# Copy to .env for your computer; on Vercel set these in Settings → Environment Variables.
# Neon connection string (Neon → Connect → copy the pooled one, with -pooler in the host).
# Leave it out to use a local SQLite file instead (instance/bestbuy.db).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
